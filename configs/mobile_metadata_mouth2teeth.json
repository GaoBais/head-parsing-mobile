{
  "model_name": "HeadParsingMobile320Teeth",
  "run_id": "mouth2teeth_v2",
  "task": "head_semantic_segmentation",
  "input": {
    "name": "image",
    "shape": [1, 3, 320, 320],
    "layout": "NCHW",
    "color": "RGB",
    "dtype": "float32",
    "resize": "bilinear_to_320x320",
    "normalization": {
      "scale": 0.00392156862745098,
      "mean": [0.485, 0.456, 0.406],
      "std": [0.229, 0.224, 0.225],
      "formula": "((rgb / 255.0) - mean) / std"
    }
  },
  "output": {
    "name": "logits",
    "shape": [1, 20, 320, 320],
    "layout": "NCHW",
    "activation": "none",
    "postprocess": "argmax over class/channel dimension, then nearest-neighbor resize mask to display size if needed"
  },
  "classes": [
    {"id": 0, "name": "background", "color": [0, 0, 0]},
    {"id": 1, "name": "skin", "color": [255, 85, 0]},
    {"id": 2, "name": "l_brow", "color": [255, 170, 0]},
    {"id": 3, "name": "r_brow", "color": [255, 0, 85]},
    {"id": 4, "name": "l_eye", "color": [255, 0, 170]},
    {"id": 5, "name": "r_eye", "color": [0, 255, 0]},
    {"id": 6, "name": "eye_g", "color": [85, 255, 0]},
    {"id": 7, "name": "l_ear", "color": [170, 255, 0]},
    {"id": 8, "name": "r_ear", "color": [0, 255, 85]},
    {"id": 9, "name": "ear_r", "color": [0, 255, 170]},
    {"id": 10, "name": "nose", "color": [0, 0, 255]},
    {"id": 11, "name": "mouth", "color": [85, 0, 255]},
    {"id": 12, "name": "u_lip", "color": [170, 0, 255]},
    {"id": 13, "name": "l_lip", "color": [0, 85, 255]},
    {"id": 14, "name": "neck", "color": [0, 170, 255]},
    {"id": 15, "name": "neck_l", "color": [255, 255, 0]},
    {"id": 16, "name": "cloth", "color": [255, 255, 85]},
    {"id": 17, "name": "hair", "color": [255, 255, 170]},
    {"id": 18, "name": "hat", "color": [255, 0, 255]},
    {"id": 19, "name": "teeth", "color": [0, 255, 255]}
  ]
}
